# ---------------------------------------------------------------------------
# Global Scholarship Hub - environment template
# Copy to `.env` and fill in real values. NEVER commit `.env` itself.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/global_scholarship_hub"

# Absolute site origin, used for canonical URLs and social cards.
NEXT_PUBLIC_SITE_URL="https://globalscholarshiphub.com"

# Public base URL of the running app.
APP_URL="http://localhost:2055"

# Port `next dev` and `next start` listen on. Keep the two above in step with
# this. Do not add NODE_ENV here: Next.js sets it per command, and a value in
# this file reaches `next build` and breaks prerendering.
PORT="2055"

# ---------------------------------------------------------------------------
# Sessions
# Must be a long random string. Used to sign session cookies.
# Generate: openssl rand -base64 32
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:2055"

# ---------------------------------------------------------------------------
# Admin bootstrap
# Read ONLY by `npm run db:seed` to create the first administrator.
# Leave ADMIN_PASSWORD unset in production and create admins through
# /admin/users instead, so credentials never sit in a committed file.
# ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-before-running-the-seed"
ADMIN_NAME="Site Administrator"
ADMIN_ROLE="SUPER_ADMIN"

# ---------------------------------------------------------------------------
# Public JSON API
# The browser does not use /api/* - public pages read the database directly and
# forms post through server actions. The routes stay for external consumers and
# the verification scripts, and `src/proxy.ts` returns 404 for any caller
# that is neither local nor presenting this key as `x-api-key` (or
# `Authorization: Bearer ...`). Leave it empty to disable the API entirely from
# outside the machine, keeping only local access.
# Generate: openssl rand -hex 32
# ---------------------------------------------------------------------------
PUBLIC_API_KEY=""

# ---------------------------------------------------------------------------
# Email (optional) - only needed once notifications are enabled
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# ---------------------------------------------------------------------------
# Storage
# Directory (relative to public/) that receives admin media uploads.
# ---------------------------------------------------------------------------
UPLOAD_DIR="uploads"

# Maximum accepted upload size in megabytes.
UPLOAD_MAX_MB="10"

# ---------------------------------------------------------------------------
# Rate limiting for sensitive endpoints (login, import, upload)
# ---------------------------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS="20"
RATE_LIMIT_WINDOW_MS="60000"
